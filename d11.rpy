init:
    $ swim = True
    $ timer_range = 0
    $ timer_jump = 0
screen countdown:
    timer 0.01:
        repeat True
        action If(time > 0, true=SetVariable('time', time - 0.01), false=[Hide('countdown'), Jump(timer_jump)])
label d11:
    stop music fadeout 2.0
        pass
    scene day11
    with dissolve_scene_full
    window hide
        pass
    pause 5.0
        pass
    scene black
    with dissolve_scene_full
    pause 4.0
        pass
    "Сонячні промені пробиваються крізь жалюзі, і мої очі повільно відкриваються."
    scene mcg_6
    with dissolve_scene_full
    play music t9
        pass
    "Моніка лежить поруч, я чую її спокійне дихання."
    "Схоже, вона ще не прокинулась."
    m "Ммммгхх...."
    "Та ні, прокинулась..."
    scene mcg_3
    m "Аааах~"
    m "Доброго ранку, коханий~"
    scene mcg_7
    menu:
        "Доброго ранку!":
            pass
    "Ми обоє нехотя підводимося з ліжка."
    stop music fadeout 2.0
        pass
    scene bg bedroom
    show monika p_1a at t11
    with wipeleft_scene
    play music t8
        pass
    mc "Ну що ж, сьогодні ми йдемо на плавання!"
    m p_2j "Мхм~"
    m p_5a "Не терпиться побачити мене у купальнику~?"
    m p_2j "Ехехе~"
    show monika at lhide
    hide monika
    "Моніка заходить до ванної з речами в руках."
    "Поки вона там, я теж встигаю переодягнутись."
    "Подумати тільки... Мабуть, варто одягти плавки одразу під низ."
    show monika o2_1c at l11
    "Моніка повертається й складає піжаму."
    menu:
        "Хочеш, я зроблю сніданок?":
            pass
    m o2_1b "Ооох! Було б чудово!"
    m "Що будеш готувати?"
    show monika o2_1a
    mc "Ще не знаю. Перевірю, що є в холодильнику."
    m o2_1b "А, добре."
    m o2_2d "Тоді я поки закінчу тут."
    scene bg kitchen
    with wipeleft_scene
    "Я кілька секунд дивлюсь у холодильник."
    "..."
    "...Можна приготувати картопляні деруни."
    "Закриваю холодильник, нічого не діставши."
    "Йду до комори, беру велику картоплину та чищу її."
    "А тепер найгірше — натирати."
    "Я вже майже закінчив, коли Моніка повертається з сумкою через плече."
    show monika o2_1b at l11
    m "Ооох~"
    m "Що ти готуєш?"
    show monika o2_1a
    mc "Деруни-{nw}"
    show monika o2_1c at h11
    $ _history_list.pop()
    mc "Деруни-{fast} Ай!"
    "Я випадково злегка зачіпаю палець теркою."
    m o2_2g "Ти в порядку?"
    show monika o2_2f
    mc "Так, все нормально."
    m o2_4i "Зачекай, я принесу перекис водню."
    show monika at lhide
    hide monika
    mc "Почекай—Моніко! Не треба, все гаразд!"
    m "Ні-ні! І не заперечуй!"
    show monika o2_1h at l11
    "Вона повертається з ваткою та пляшкою перекису."
    m o2_1g "Добре, дай руку."
    show monika o2_2f
    mc "Моніко, кажу ж — все добре!"
    m o2_2i "Мені байдуже! Тепер стій спокійно..."
    show monika o2_2f
    "Моніка обережно обробляє поріз, перев’язує його й викидає ватку."
    m o2_2b "Ось і все!"
    show monika o2_1a
    mc "Дякую..."
    m o2_5b "А тепер будь обережнішим із теркою!"
    show monika at thide
    hide monika
    "Я продовжую терти картоплю, поки Моніка займається своїм."
    "Кладу терту картоплю в холодну воду на кілька секунд, а потім дістаю й підсушую."
    "Наливаю трохи олії на сковорідку й ставлю її на плиту."
    "Коли нагрілась, кидаю картоплю обсмажувати."
    "Виймаю й кладу в миску."
    "Додаю борошно, спеції та трохи сиру, перемішую."
    "Формую деруни й знову кладу на сковорідку до золотистої скоринки."
    "Викладаю їх на паперовий рушник і залишаю зайву олію охолонути в духовці."
    mc "Готово, сніданок подано!"
    show monika o2_1a at l11
    "Моніка підходить і сідає за стіл."
    mc "Обачніше, не забрудни плаття жиром."
    m o2_1b "Так, знаю."
    m o2_2k "Виглядає апетитно!"
    show monika o2_1a
    mc "Дякую."
    "Ми наїлися досхочу, і я знову завантажую тарілки в посудомийну."
    mc "Гей, може, візьмемо щось перекусити біля басейну?"
    m o2_2c "Хммм... можливо."
    m o2_2d "Напевно, варто, адже там будемо майже цілий день."
    m o2_1d "Може, зробимо оніґірі чи щось таке."
    show monika o2_1c
    mc "Добре. Поставлю рис варитися."
    m o2_1b "Дякую, [player]."
    m o2_2b "Я тим часом зберу решту речей для басейну."
    show monika o2_1a
    mc "Це ж відкритий басейн, так?"
    m o2_1j "Мхм~"
    m o2_2b "І прогноз каже, що буде сонячно весь день!"
    show monika o2_1a
    mc "Чудово!"
    show monika at lhide
    hide monika
    "Моніка йде пакувати, а я запускаю рисоварку."
    "Поки вона працює, я дістаю кілька контейнерів і ставлю їх убік."
    "Також наливаю воду в пляшку й відставляю."
    "За кілька хвилин перевіряю рис."
    "Схоже, вже готовий."
    "Вимикаю рисоварку й дістаю з комори норі."
    "Потрібно ще щось для начинки..."
    "Цікаво, що саме..."
    mc "Моніко, з чим хочеш оніґірі?"
    show monika forward redskirt ldown rhip dist cm oe at l11
    m "Еммм..."
    m o2_1b "Давай із малиною або ожиною!"
    show monika o2_1a
    mc "Добре, зараз подивлюсь, чи є..."
    "Я зазираю до холодильника."
    "І справді, на нижній полиці лежить упаковка кожної ягоди."
    "Дістаю їх і кладу на стіл."
    m o2_2k "Я допоможу тобі~"
    show monika o2_1a
    mc "Дякую, Моніко."
    "Ми обоє беремо жменю рису й загортаємо ягоди всередину."
    "Я надаю своїм звичної трикутної форми й обгортаю низ смужкою норі."
    show monika o2_2j
    "Моніка робить так само, і ми заповнюємо контейнер оніґірі."
    show monika o2_1a
    mc "Гадаю, цього вистачить. Навіть забагато."
    m o2_2d "Так. Я покладу це в сумку."
    show monika o2_1a
    mc "Коли ми виходимо?"
    m o2_1d "Еее..."
    m o2_2d "Приблизно опівдні, думаю."
    show monika o2_1c
    mc "А, ясно."
    "Я дивлюсь на годинник."
    "{i}11:02.{/i}"
    mc "Ще маємо трохи часу."
    mc "Я піду відпочину на балконі."
    m o2_1b "Добре, скоро приєднаюсь."
    show monika at thide
    hide monika
    "Моніка йде у вітальню дор пакувати, а я піднімаюсь нагору."
