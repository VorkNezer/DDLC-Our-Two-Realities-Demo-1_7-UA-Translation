init:
    $ timer_range = 0
    $ timer_jump = 0
screen countdown:
    timer 0.01:
        repeat True
        action If(time > 0, true=SetVariable('time', time - 0.01), false=[Hide('countdown'), Jump(timer_jump)])
label d2:
    stop music fadeout 2.0
        pass
    scene day2
    with dissolve_scene_full
    window hide
        pass
    pause 5.0
        pass
    scene black
    with dissolve_scene_full
    pause 4.0
        pass
    play sound "mod_assets/sfx/smoke.ogg" loop fadein 10.0
        pass
    pause 5.0
        pass
    "Ух...."
    "Га..?"
    scene bg bedroom
    with wipeleft_scene
    "Я різко підскакую з ліжка, коли чую, як спрацьовує пожежна сигналізація."
    show monika p_1d at t11
    m "Що відбувається?"
    mc "Не знаю, але це не наша сигналізація..."
    mc "Зачекай...."
    show monika pj forward lpoint rdown s_scream
    m "Сайорі!"
    scene bg house
    with wipeleft_scene
    "Ми вибігаємо на вулицю і біжимо до будинку Сайорі."
    scene bg house
    with wipeleft_scene
    "Двері відкриті..."
    "Я бачу трохи диму, що йде зсередини."
    "Я швидко забігаю всередину разом з Монікою."
    scene bg kitchen
    with wipeleft_scene
    show protag 5bv at t21
    show sayori casual turned lup rup cry cm oe at t22
    play music t7
        pass
    "Коли я вбігаю на кухню, бачу, як ГГ гасить дуже чорну сковорідку вогнегасником."
    "Сайорі стоїть у кутку і плаче."
    show sayori casual turned lup rup cry om oe at f22
    s "Вибачте!!"
    show monika pj forward ldown rdown doub cm oe at l31
    show protag 5bw at f32
    show sayori casual turned lup rup cry cm oe at t33
    p "Чорт, Сайорі! Це вже {b}ДРУГИЙ{/b} раз, коли ти мало не спалила будинок!"
    p "Тобі заборонено торкатися плити!"
    show protag 5bv at t32
    stop sound
        pass
    "Коли вогонь згас, у сковорідці залишився дуже чорний, обвуглений... млинець?"
    "Здається, це млинець."
    mc "Ем, Сайорі, це... мало бути млинцем?"
    show sayori casual turned lup rup cry cm oe at f33
    s "...так..."
    s casual turned lup rup cry om oe "Я хотіла здивувати ГГ, але не знала, скільки часу треба..."
    show sayori casual turned lup rup cry cm oe at t33
    mc "Що взагалі сталося?"
    show protag 1bs at s32
    p "*зітхає*"
    show protag 5bx at f32
    p "Я зайшов на кухню, коли відчув запах гару. Коли прийшов..."
    show protag 5bv at t32
    show sayori casual turned lup rup cry om oe at f33
    s "Я випадково залишила млинці на плиті!"
    s "І вони загорілися!"
    show sayori casual turned lup rup cry cm oe at t33
    show monika p_1q at t31
    "..."
    stop music fadeout 2.0
        pass
    show monika p_1b at f31
    show protag 5bb at t32
    play music t8
        pass
    m p_2b "Гей, Сайорі."
    show monika p_2a at t31
    show sayori casual turned lup rup cry cm oe at f33
    s "*шморгає*{w=0.5} Так...?"
    show sayori casual turned lup rup cry cm oe at t33
    show monika p_1l at f31
    m "Давай я допоможу тобі зробити ці млинці?"
    show monika p_1a at t31
    show sayori 4bu at f33
    s "*шморгає*{w=0.5} Добре..."
    scene bg house
    with wipeleft_scene
    "Ми йдемо до нашого будинку, а ГГ залишається прибирати безлад."
    "Сайорі бере із собою те, що залишилося від тіста."
    scene bg kitchen
    with wipeleft_scene
    "Моніка і Сайорі йдуть на кухню."
    show monika p_2l at t22
    show sayori 4bl at t21
    "Сайорі починає смажити млинець, а Моніка показує їй, на що звертати увагу і коли перевертати."
    show sayori 3br
    show monika p_1j
    "Через деякий час, після кількох невдач, вони приносять цілу стопку свіжих млинців."
    "Щойно вони закінчують, ГГ теж заходить у двері."
    show monika p_1j at t33
    show sayori 1bq at t32
    show protag 1ba at l31
    "Всі сідають і беруть собі млинці."
    "Моніка приносить кілька топінгів, і ми додаємо все, що нам подобається."
    "Сайорі набиває свій млинець джемом і вершками."
    "ГГ намазує шоколадну пасту і кленовий сироп."
    "Моніка бере джем і змішує його з кленовим сиропом."
    "Я додаю свої улюблені топінги, і ми всі починаємо їсти."
    show sayori 3br at f32
    s "Смаааачно!"
    s "Вони такі смачні!"
    s 2bx "Дякую, що показала мені, як їх готувати, Моніка!"
    show sayori 1ba at t32
    show monika p_2n at f33
    m "Без проблем, Сайорі."
    m p_2l "Тільки наступного разу не забувай засікати час."
    m "І якщо побачиш дим — знімай з плити."
    m "Інакше ГГ знову розсердиться."
    show monika p_1a at t33
    show sayori 1ba at t32
    show protag 1ba at t31
    "Ми всі доїдаємо сніданок."
